{
  "name": "playwright-pom-framework",
  "version": "1.0.0",
  "private": true,
  "description": "A maintainable Playwright end-to-end testing framework using TypeScript and the Page Object Model.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test tests/login.spec.ts --project=chromium",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
